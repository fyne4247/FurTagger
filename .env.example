# FurTag credentials — copy to .env and fill in the lines you actually use.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. NEVER commit it, paste it into an issue, or share it.
#
# Every value here wins over whatever is in the OS keyring, so a filled-in .env
# means FurTag never touches the keychain — which is the point on macOS, where
# running from source prompts for the login keychain password on every launch.
# Leave a line blank or delete it to fall back to the keyring for that field.
#
# Quote any value containing spaces or #. Empty is the same as unset.

# Bypass the OS keyring completely — the values below are the only source.
# On macOS this is what actually stops the repeating keychain password
# prompt when running from source. Comment it out to use the keyring again.
FURTAG_DISABLE_KEYRING=1

# ── e621 ─────────────────────────────────────────────────────────────────────
FURTAG_E621_USERNAME=
FURTAG_E621_API_KEY=

# ── Inkbunny ─────────────────────────────────────────────────────────────────
FURTAG_INKBUNNY_USERNAME=
FURTAG_INKBUNNY_PASSWORD=

# ── Danbooru ─────────────────────────────────────────────────────────────────
FURTAG_DANBOORU_USERNAME=
FURTAG_DANBOORU_API_KEY=

# ── Gelbooru ─────────────────────────────────────────────────────────────────
FURTAG_GELBOORU_USER_ID=
FURTAG_GELBOORU_API_KEY=

# ── SauceNAO ─────────────────────────────────────────────────────────────────
FURTAG_SAUCE_NAO_API_KEY=

# ── Hydrus ───────────────────────────────────────────────────────────────────
FURTAG_HYDRUS_API_URL=
FURTAG_HYDRUS_ACCESS_KEY=
